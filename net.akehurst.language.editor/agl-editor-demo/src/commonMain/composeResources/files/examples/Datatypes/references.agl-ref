namespace net.akehurst.language.example.Datatypes
    identify Primitive by id
    identify Datatype by id
    identify Collection by id

    references {
        in TypeReference {
            // 'Collection' is qualified, because the std library also has a type named Collection
            property type refers-to Primitive|Datatype|net.akehurst.language.example.Datatypes.Collection
        }
    }
